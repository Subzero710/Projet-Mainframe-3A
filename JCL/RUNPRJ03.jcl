//RUNPRJ03 JOB MSGLEVEL=1,REGION=0M,NOTIFY=&SYSUID,CLASS=A,MSGCLASS=H
//JOBLIB   DD DSN=ENSISA.EXEC.LOAD,DISP=SHR
//*---------------------------------------------------------
//* 1. SUPPRESSION DU FICHIER DE SORTIE SI DEJA EXISTANT
//*---------------------------------------------------------
//DELETE   EXEC PGM=IEFBR14
//DD1      DD DSN=ENSISA.PROJET03.FICOUT,
//            DISP=(MOD,DELETE,DELETE),
//            UNIT=SYSALLDA,SPACE=(CYL,5)
//*---------------------------------------------------------
//* 2. EXECUTION DU PROGRAMME EN ENVIRONNEMENT DB2 (IKJEFT01)
//*---------------------------------------------------------
//STEP01   EXEC PGM=IKJEFT01
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//* FICHIER DES MOUVEMENTS EN ENTREE :
//SYS010   DD DSN=ENSISA.SAMPLE.FICPRJ.PRJ03,DISP=SHR
//* FICHIER DES MOUVEMENTS VALIDES EN SORTIE :
//SYS020   DD DSN=ENSISA.PROJET03.FICOUT,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(15,15),RLSE),UNIT=SYSDA,
//            DCB=(DSORG=PS,RECFM=FB,LRECL=200)
//* COMMANDES DE CONNEXION DB2 :
//SYSTSIN  DD *
  DSN SYSTEM(DBC0)
  RUN PROGRAM(PRJ03P01) PLAN(TPERSPGM)
  END
/*
